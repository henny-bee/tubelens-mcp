MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PUBLIC_BASE_URL=https://youtube.example.com
AUTH_MODE=bearer
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Optional JSON map of token -> {"principal_id": "op", "scopes": ["read", "media:download", "admin:jobs"]}
MCP_TOKENS_JSON=
DATA_DIR=/data

WHISPER_ENABLED=true
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=1
WHISPER_BEAM_SIZE=1
WHISPER_VAD_ENABLED=true

MAX_ASR_CONCURRENCY=1
MAX_QUEUE_SIZE=10
MAX_ASR_DURATION_SECONDS=2700
MAX_AUDIO_WORK_BYTES=262144000
ASR_TIMEOUT_SECONDS=1800
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=900
METADATA_TIMEOUT_SECONDS=30
CAPTION_TIMEOUT_SECONDS=20
MAX_MCP_RESPONSE_CHARS=12000

METADATA_CACHE_TTL_SECONDS=21600
CAPTION_CACHE_TTL_SECONDS=604800
ASR_CACHE_TTL_SECONDS=2592000
ARTIFACT_TTL_SECONDS=86400
MAX_STORAGE_BYTES=5368709120

RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_TOOL_CALLS=8
CLEANUP_INTERVAL_SECONDS=300

ENABLE_MEDIA_DOWNLOAD=false
ENABLE_COMMENT_EXTRACTION=true
ENABLE_SEARCH=true
LOG_LEVEL=INFO
